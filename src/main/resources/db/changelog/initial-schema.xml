    <changeSet id="create-trait-likes-summary-view" runOnChange="true" author="ristovljupcho">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="trait_likes_summary"/>
            </not>
        </preConditions>
        <sql>
            CREATE
            MATERIALIZED VIEW trait_likes_summary AS
            SELECT t.id, t.trait_type, t.name, tt.total_likes
            FROM trait AS t
                     JOIN (SELECT trait_id, SUM(like_counter) AS total_likes
                           FROM place_trait
                           GROUP BY trait_id) AS tt ON t.id = tt.trait_id
            ORDER BY total_likes DESC;
        </sql>
    </changeSet>

    <changeSet id="create-place-top-traits-view" runOnChange="true" author="ristovljupcho">
        <sql>DROP MATERIALIZED VIEW IF EXISTS place_top_traits CASCADE;</sql>
        <sql>
            CREATE
            MATERIALIZED VIEW place_top_traits AS
            WITH ranked_traits AS (
                SELECT
                    pt.place_id,
                    t.name AS trait_name,
                    ROW_NUMBER() OVER (
                        PARTITION BY pt.place_id
                        ORDER BY
                            CASE pt.priority
                                WHEN 'PAID_PROMOTION' THEN 100
                                WHEN 'FAVOURITE' THEN 80
                                WHEN 'TRENDING' THEN 60
                                WHEN 'DEFAULT' THEN 20
                                WHEN 'LOW' THEN 0
                                ELSE 0
                            END DESC,
                            pt.like_counter DESC,
                            t.name ASC
                    ) AS rn
                FROM place_trait pt
                JOIN trait t ON t.id = pt.trait_id
            )
            SELECT place_id,
                   ARRAY_AGG(trait_name ORDER BY rn) AS top_traits
            FROM ranked_traits
            WHERE rn &lt;= 5
            GROUP BY place_id;
        </sql>
        <sql>CREATE UNIQUE INDEX place_top_traits_place_id_idx ON place_top_traits (place_id);</sql>
    </changeSet>

    <changeSet id="refresh-all-views" author="system" runAlways="true">
        <sql>REFRESH MATERIALIZED VIEW trait_likes_summary;</sql>
        <sql>REFRESH MATERIALIZED VIEW place_top_traits;</sql>
    </changeSet>
